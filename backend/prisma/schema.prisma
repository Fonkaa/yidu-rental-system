generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  notifications            Notification[]
  id                       String          @id @default(uuid())
  fullName                 String
  email                    String          @unique
  passwordHash             String
  phone                    String?
  role                     Role            @default(TENANT)
  resetToken               String?
  resetTokenExpiry         DateTime?
  otpCode                  String?         // <--- Added OTP Code field
  otpExpiry                DateTime?       // <--- Added OTP Expiry field
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  isActive                 Boolean         @default(true)
  familyNumber             Int?
  faydaNumber              String?
  gender                   String?
  maritalStatus            String?
  favorites                Favorite[]
  leases                   Lease[]
  receivedMessages         Message[]       @relation("MessageReceiver")
  sentMessages             Message[]       @relation("MessageSender")
  properties               Property[]
  rentalRequestsAsLandlord RentalRequest[] @relation("LandlordRentalRequests")
  rentalRequestsAsTenant   RentalRequest[] @relation("TenantRentalRequests")
}

model Property {
  id                  String          @id @default(uuid())
  titleEn             String
  titleAm             String?
  descriptionEn       String
  descriptionAm       String?
  price               Float
  rooms               Int
  furnished           Boolean         @default(false)
  landmarkDescription String?
  gpsLat              Float?
  gpsLng              Float?
  status              ListingStatus   @default(PENDING)
  rejectionReason     String?         // <--- Added rejection reason here
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  landlordId          String
  categoryId          String
  locationId          String
  favorites           Favorite[]
  leases              Lease[]
  messages            Message[]
  category            Category        @relation(fields: [categoryId], references: [id])
  landlord            User            @relation(fields: [landlordId], references: [id])
  location            Location        @relation(fields: [locationId], references: [id])
  images              PropertyImage[]
  rentalRequests      RentalRequest[]

  @@index([landlordId])
  @@index([categoryId])
  @@index([locationId])
  @@index([status])
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  properties  Property[]
}

model Location {
  id             String     @id @default(uuid())
  city           String
  subCity        String?
  kebeleOrWoreda String?
  region         String?
  properties     Property[]
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  propertyId String?
  text       String
  isRead     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  property   Property? @relation(fields: [propertyId], references: [id])
  receiver   User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([propertyId])
  @@index([createdAt])
}

model RentalRequest {
  id            String              @id @default(uuid())
  tenantId      String
  propertyId    String
  message       String?
  status        RentalRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  endDate       DateTime?
  landlordId    String
  proposedPrice Float?
  startDate     DateTime?
  landlord      User                @relation("LandlordRentalRequests", fields: [landlordId], references: [id], onDelete: Cascade)
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant        User                @relation("TenantRentalRequests", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId])
  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([status])
}

model Lease {
  id         String      @id @default(uuid())
  tenantId   String
  propertyId String
  startDate  DateTime
  endDate    DateTime
  rentAmount Float
  status     LeaseStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     User        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment    Payment?

  @@index([tenantId])
  @@index([propertyId])
  @@index([status])
}

model Notification {
  id                String    @id @default(uuid())
  userId            String    // <--- Add this foreign key field
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  readAt            DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade) // <--- Add this relation link

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model CommissionSetting {
  id               String   @id @default(uuid())
  ratePercent      Float    @default(10)
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

model Payment {
  id                   String        @id @default(uuid())
  leaseId              String        @unique
  amount               Decimal       @db.Decimal(10, 2)
  commissionAmount     Decimal       @db.Decimal(10, 2)
  gatewayTransactionId String?       @unique
  method               String        @default("Telebirr")
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  lease                Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  UNAVAILABLE
  RENTED
  EXPIRED
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}